# ===================================================================
# Microsoft Imagine Cup 2026 - Azure AI Configuration
# ===================================================================

# Azure OpenAI Configuration (Primary Semantic Scorer)
# Get these from Azure Portal > Azure OpenAI Service
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENABLED=
AZURE_OPENAI_MAX_CHARS=

# Azure AI Content Safety Configuration (Harm Detection)
# Get these from Azure Portal > Content Safety Service
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_ENABLED=


AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENABLED=
# ===================================================================
# Application Configuration
# ===================================================================

APP_ENV=
APP_SECRET=
DATABASE_URL=

# Watermark Configuration
WATERMARK_SEED=your-watermark-secret-seed

# ===================================================================
# AI Detection Configuration
# ===================================================================

# Hugging Face AI Detection (Supporting Signal)
HF_MODEL_NAME=disabled
HF_TOKENIZER_NAME=disabled
HF_DEVICE=-1
HF_SCORE_THRESHOLD=0.6

# Ollama Configuration (DEPRECATED - kept for backward compatibility)
# Set OLLAMA_ENABLED=false to disable (Azure OpenAI is now primary)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_PROMPT_CHARS=2000

# ===================================================================
# External API Configuration
# ===================================================================

# Sightengine Image Detection API (Optional)
SIGHTENGINE_API_USER=your-sightengine-user-id
SIGHTENGINE_API_SECRET=your-sightengine-api-secret


JWT_SECRET_KEY=your-secret-key
ENVIRONMENT=dev



# ===================================================================
# Setup Instructions for Microsoft Imagine Cup 2026
# ===================================================================
#
# 1. Azure OpenAI Setup:
#    - Create Azure OpenAI resource in Azure Portal
#    - Deploy a GPT-4 or GPT-4o-mini model
#    - Copy endpoint URL and API key above
#    - Update AZURE_OPENAI_DEPLOYMENT_NAME with your deployment name
#
# 2. Azure Content Safety Setup:
#    - Create Content Safety resource in Azure Portal
#    - Copy endpoint URL and API key above
#    - Enable content moderation in your resource
#
# 3. Install Dependencies:
#    pip install -r requirements.txt
#
# 4. Run Application:
#    uvicorn app.main:app --reload
#
# ===================================================================